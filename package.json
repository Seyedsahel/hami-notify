{
  "name": "hami-notify",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:api": "node --env-file-if-exists=.env scripts/check-api.mjs",
    "verify:static": "node --env-file-if-exists=.env scripts/check-static.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
